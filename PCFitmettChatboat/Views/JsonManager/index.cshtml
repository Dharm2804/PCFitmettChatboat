@{
    ViewData["Title"] = "JSON Data Manager";
    Layout = null;
}

<style>
    * { box-sizing: border-box; }
    .jm { max-width: 1500px; margin: auto; padding: 22px; color: #1f2937; }
    .jm .panel, .jm .stat { background: #fff; border-radius: 12px; box-shadow: 0 2px 10px #00000012; }
    .jm .header { padding: 24px; margin-bottom: 18px; }
    .jm .header h1 { margin: 0 0 8px; font-size: 28px; }
    .jm .muted { color: #6b7280; }
    .jm .toolbar { padding: 16px; margin-bottom: 18px; display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .jm button, .jm select, .jm input, .jm textarea { font: inherit; }
    .jm button { border:0; border-radius:7px; padding:10px 14px; cursor:pointer; color:#fff; font-weight:600; }
    .jm button:hover { opacity:.88; }
    .jm .primary { background:#2563eb; } .jm .success { background:#16a34a; }
    .jm .warning { background:#d97706; } .jm .danger { background:#dc2626; }
    .jm .secondary { background:#6b7280; } .jm .info { background:#0891b2; }
    .jm select, .jm input, .jm textarea { padding:10px 12px; border:1px solid #d1d5db; border-radius:7px; }
    .jm .search { flex:1; min-width:220px; }
    .jm .search input { width:100%; }
    .jm .file-info { width:100%; font-size:12px; overflow-wrap:anywhere; }
    .jm .stats { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:14px; margin-bottom:18px; }
    .jm .stat { padding:17px; } .jm .label { color:#6b7280; font-size:13px; margin-bottom:8px; }
    .jm .value { font-size:25px; font-weight:700; }
    .jm .table-wrap { overflow:auto; }
    .jm table { width:100%; border-collapse:collapse; min-width:1050px; }
    .jm thead { background:#111827; color:white; }
    .jm th,.jm td { padding:12px; border-bottom:1px solid #e5e7eb; text-align:left; vertical-align:middle; font-size:13px; }
    .jm td.url { max-width:350px; overflow-wrap:anywhere; }
    .jm a { color:#2563eb; text-decoration:none; }
    .jm .badge { display:inline-block; padding:5px 9px; border-radius:20px; background:#f3f4f6; color:#4b5563; font-weight:700; }
    .jm .true { background:#dcfce7; color:#166534; } .jm .deleted { background:#fee2e2; color:#991b1b; }
    .jm .actions { display:flex; flex-wrap:wrap; gap:5px; }
    .jm .actions button { padding:7px 9px; font-size:12px; }
    .jm .modified-row { background:#fffbeb; } .jm .deleted-row { background:#fef2f2; }
    .jm .empty { text-align:center; padding:35px; color:#6b7280; }
    .jm .status { display:none; padding:11px 14px; margin-bottom:14px; border-radius:7px; }
    .jm .status.show { display:block; } .jm .status.success-msg { background:#dcfce7; color:#166534; }
    .jm .status.error-msg { background:#fee2e2; color:#991b1b; } .jm .status.info-msg { background:#dbeafe; color:#1e40af; }
    .jm .modal { display:none; position:fixed; inset:0; z-index:10000; background:#0008; align-items:center; justify-content:center; padding:18px; }
    .jm .modal.show { display:flex; } .jm .modal-content { background:white; width:100%; max-width:650px; max-height:90vh; overflow:auto; padding:24px; border-radius:12px; }
    .jm .modal-content h2 { margin-top:0; } .jm .form-group { margin-bottom:16px; }
    .jm .form-group label { display:block; font-weight:600; margin-bottom:7px; }
    .jm .form-group input,.jm .form-group textarea { width:100%; }
    .jm textarea { min-height:160px; } .jm .modal-actions { display:flex; justify-content:flex-end; gap:9px; margin-top:18px; }
    .jm .json-preview { white-space:pre; overflow:auto; max-height:60vh; background:#111827; color:#d1d5db; padding:14px; border-radius:8px; font:12px Consolas,monospace; }
    @@media(max-width:900px) { .jm .stats { grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @@media(max-width:600px) { .jm { padding:10px; } .jm .stats { grid-template-columns:1fr; } .jm .toolbar { align-items:stretch; flex-direction:column; } .jm .toolbar button,.jm .toolbar select { width:100%; } }
</style>

<div class="jm">
    <div class="panel header">
        <h1 id="pageTitle">Articles Manager</h1>
        <p class="muted">Manage articles.json and pdf.json from the project's data folder.</p>
    </div>

    <div id="statusMessage" class="status" role="status"></div>

    <div class="panel toolbar">
        <select id="sourceSelect" aria-label="JSON source">
            <option value="articles">Articles</option>
            <option value="pdf">PDF</option>
        </select>
        <button class="success" id="saveBtn">💾 Save Changes</button>
        <button class="info" id="addBtn">➕ Add URL</button>
        <button class="warning" id="bulkBtn">➕ Add Multiple</button>
        <button class="secondary" id="previewBtn">👁 JSON Preview</button>
        <button class="secondary" id="reloadBtn">🔄 Reload</button>
        <div class="search"><input id="searchInput" placeholder="Search by ID or URL..." /></div>
        <div class="file-info">JSON file: <strong id="fileName">Loading...</strong><br />Server path: <span id="filePath"></span></div>
    </div>

    <div class="stats">
        <div class="stat"><div class="label">Total</div><div class="value" id="totalCount">0</div></div>
        <div class="stat"><div class="label">Updated</div><div class="value" id="updatedCount">0</div></div>
        <div class="stat"><div class="label">Deleted</div><div class="value" id="deletedCount">0</div></div>
        <div class="stat"><div class="label">With Previous URL</div><div class="value" id="previousCount">0</div></div>
        <div class="stat"><div class="label">Active</div><div class="value" id="activeCount">0</div></div>
    </div>

    <div class="panel table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Current URL</th><th>Previous URL</th><th>Flag Update</th><th>Delete</th><th>Actions</th></tr></thead>
            <tbody id="recordsBody"><tr><td colspan="6" class="empty">Loading...</td></tr></tbody>
        </table>
    </div>

    <div class="modal" id="addModal">
        <div class="modal-content">
            <h2>Add New URL</h2>
            <div class="form-group"><label for="newUrl">Current URL</label><input id="newUrl" type="url" placeholder="https://example.com/article" /></div>
            <div class="modal-actions"><button class="secondary" data-close="addModal">Cancel</button><button class="success" id="confirmAddBtn">Add URL</button></div>
        </div>
    </div>

    <div class="modal" id="changeModal">
        <div class="modal-content">
            <h2>Change URL</h2>
            <div class="form-group"><label for="changeId">ID</label><input id="changeId" readonly /></div>
            <div class="form-group"><label for="oldUrl">Current URL (will become Previous URL)</label><input id="oldUrl" readonly /></div>
            <div class="form-group"><label for="changeUrl">New Current URL</label><input id="changeUrl" type="url" placeholder="Enter new URL" /></div>
            <div class="modal-actions"><button class="secondary" data-close="changeModal">Cancel</button><button class="success" id="confirmChangeBtn">Change URL</button></div>
        </div>
    </div>

    <div class="modal" id="bulkModal">
        <div class="modal-content">
            <h2>Add Multiple URLs</h2>
            <div class="form-group"><label for="bulkUrls">One URL per line</label><textarea id="bulkUrls" placeholder="https://example.com/article-1&#10;https://example.com/article-2"></textarea></div>
            <div class="modal-actions"><button class="secondary" data-close="bulkModal">Cancel</button><button class="success" id="confirmBulkBtn">Add URLs</button></div>
        </div>
    </div>

    <div class="modal" id="previewModal">
        <div class="modal-content" style="max-width:1000px">
            <h2>JSON Preview</h2><pre id="jsonPreview" class="json-preview"></pre>
            <div class="modal-actions"><button class="secondary" data-close="previewModal">Close</button><button class="success" id="copyBtn">Copy JSON</button></div>
        </div>
    </div>
</div>

<script>
    (() => {
        "use strict";

        let records = [];
        let currentSource = "articles";
        let hasUnsavedChanges = false;
        let statusTimer;

        const $ = id => document.getElementById(id);
        const endpoints = {
            load: source => '@Url.Action("Load", "JsonManager")' + '?source=' + encodeURIComponent(source),
            save: source => '@Url.Action("Save", "JsonManager")' + '?source=' + encodeURIComponent(source)
        };

async function requestJson(url, options = {}) {
    const response = await fetch(url, options);

    const result = await response.json();

    if (!response.ok) {
        throw new Error(
            result.message || `Request failed (${response.status})`
        );
    }

    return result;
}

        async function loadSource() {
            try {
                const result = await requestJson(endpoints.load(currentSource), { cache: "no-store" });
                records = (result.records || []).map(normalize);
                hasUnsavedChanges = false;
                $("pageTitle").textContent = currentSource === "articles" ? "Articles Manager" : "PDF Manager";
                $("fileName").textContent = result.fileName;
                $("filePath").textContent = result.filePath;
                render();
                stats();
                showStatus(`${result.fileName} loaded (${records.length} items).`, "success");
            } catch (error) {
                records = [];
                render();
                stats();
                showStatus(error.message, "error");
            }
        }

        function normalize(item) {
            return {
                id: Number(item.id) || 0,
                currentUrl: String(item.currentUrl || ""),
                previousUrl: String(item.previousUrl || ""),
                flagupdate: Boolean(item.flagupdate),
                delete: Boolean(item.delete)
            };
        }

        async function saveJsonFile() {
            try {
                const result = await requestJson(endpoints.save(currentSource), {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(records)
                });
                hasUnsavedChanges = false;
                showStatus(result.message, "success");
            } catch (error) {
                showStatus(error.message, "error");
            }
        }

        function getNextId() {
            return records.length ? Math.max(...records.map(x => x.id)) + 1 : 1;
        }

        function isValidUrl(value) {
            try {
                const url = new URL(value);
                return url.protocol === "http:" || url.protocol === "https:";
            } catch { return false; }
        }

        function isDuplicateUrl(value, ignoreId = null) {
            const normalized = value.trim().toLowerCase();
            return records.some(x => x.id !== ignoreId && x.currentUrl.trim().toLowerCase() === normalized);
        }

        function newRecord(url) {
            return { id: getNextId(), currentUrl: url, previousUrl: "", flagupdate: false, delete: false };
        }

        function addArticle() {
            const url = $("newUrl").value.trim();
            if (!isValidUrl(url)) return showStatus("Please enter a valid HTTP or HTTPS URL.", "error");
            if (isDuplicateUrl(url)) return showStatus("This URL already exists.", "error");
            records.push(newRecord(url));
            changed(); closeModal("addModal"); render(); stats();
            $("newUrl").value = "";
            showStatus("URL added. Click Save Changes to write it to the JSON file.", "success");
        }

        function addBulkArticles() {
            const raw = $("bulkUrls").value.trim();
            if (!raw) return showStatus("Please enter at least one URL.", "error");
            let added = 0, skipped = 0;
            raw.split(/\r?\n/).map(x => x.trim()).filter(Boolean).forEach(url => {
                if (!isValidUrl(url) || isDuplicateUrl(url)) { skipped++; return; }
                records.push(newRecord(url)); added++;
            });
            if (added) changed();
            closeModal("bulkModal"); render(); stats();
            $("bulkUrls").value = "";
            showStatus(`${added} URL(s) added; ${skipped} skipped. Click Save Changes to save.`, added ? "success" : "error");
        }

        function openChangeModal(id) {
            const record = records.find(x => x.id === id);
            if (!record) return;
            $("changeId").value = record.id;
            $("oldUrl").value = record.currentUrl;
            $("changeUrl").value = "";
            $("changeModal").classList.add("show");
            $("changeUrl").focus();
        }

        function changeArticleUrl() {
            const id = Number($("changeId").value);
            const url = $("changeUrl").value.trim();
            const record = records.find(x => x.id === id);
            if (!record) return;
            if (!isValidUrl(url)) return showStatus("Please enter a valid HTTP or HTTPS URL.", "error");
            if (record.currentUrl === url) return showStatus("New URL is the same as current URL.", "error");
            if (isDuplicateUrl(url, id)) return showStatus("This URL is already used by another item.", "error");
            record.previousUrl = record.currentUrl;
            record.currentUrl = url;
            record.flagupdate = true;
            record.delete = false;
            changed(); closeModal("changeModal"); render(); stats();
            showStatus("URL changed. Click Save Changes.", "success");
        }

        function toggleUpdate(id) {
            const record = records.find(x => x.id === id);
            if (!record) return;
            record.flagupdate = !record.flagupdate;
            changed(); render(); stats(); showStatus("Update flag changed.", "info");
        }

        function toggleDelete(id) {
            const record = records.find(x => x.id === id);
            if (!record) return;
            record.delete = !record.delete;
            changed(); render(); stats();
            showStatus(record.delete ? "Item marked for deletion." : "Item restored.", record.delete ? "error" : "success");
        }

        function undoChange(id) {
            const record = records.find(x => x.id === id);
            if (!record || !record.previousUrl) return showStatus("There is no previous URL to restore.", "error");
            if (!confirm("Restore the previous URL?")) return;
            record.currentUrl = record.previousUrl;
            record.previousUrl = "";
            record.flagupdate = false;
            changed(); render(); stats(); showStatus("Previous URL restored.", "success");
        }

        function render() {
            const search = $("searchInput").value.trim().toLowerCase();
            const filtered = records.filter(x => !search ||
                String(x.id).includes(search) ||
                x.currentUrl.toLowerCase().includes(search) ||
                x.previousUrl.toLowerCase().includes(search));

            if (!filtered.length) {
                $("recordsBody").innerHTML = `<tr><td colspan="6" class="empty">${records.length ? "No items match your search." : "This file has no items yet."}</td></tr>`;
                return;
            }

            $("recordsBody").innerHTML = filtered.map(record => {
                const rowClass = record.delete ? "deleted-row" : record.flagupdate ? "modified-row" : "";
                const current = record.currentUrl
                    ? `<a href="${escapeHtml(record.currentUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(record.currentUrl)}</a>`
                    : '<span class="muted">Empty</span>';
                const previous = record.previousUrl
                    ? `<a href="${escapeHtml(record.previousUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(record.previousUrl)}</a>`
                    : '<span class="muted">Empty</span>';
                return `<tr class="${rowClass}">
                    <td><strong>${record.id}</strong></td>
                    <td class="url">${current}</td><td class="url">${previous}</td>
                    <td><span class="badge ${record.flagupdate ? "true" : ""}">${record.flagupdate ? "TRUE" : "FALSE"}</span></td>
                    <td><span class="badge ${record.delete ? "deleted" : ""}">${record.delete ? "TRUE" : "FALSE"}</span></td>
                    <td><div class="actions">
                        <button class="info" data-action="flag" data-id="${record.id}">${record.flagupdate ? "Unflag" : "Update"}</button>
                        <button class="warning" data-action="change" data-id="${record.id}">Change URL</button>
                        ${record.previousUrl ? `<button class="secondary" data-action="undo" data-id="${record.id}">Undo</button>` : ""}
                        <button class="${record.delete ? "success" : "danger"}" data-action="delete" data-id="${record.id}">${record.delete ? "Restore" : "Delete"}</button>
                    </div></td>
                </tr>`;
            }).join("");
        }

        function stats() {
            $("totalCount").textContent = records.length;
            $("updatedCount").textContent = records.filter(x => x.flagupdate).length;
            $("deletedCount").textContent = records.filter(x => x.delete).length;
            $("previousCount").textContent = records.filter(x => x.previousUrl).length;
            $("activeCount").textContent = records.filter(x => !x.delete).length;
        }

        function changed() { hasUnsavedChanges = true; }

        function showStatus(message, type = "info") {
            const el = $("statusMessage");
            el.textContent = message;
            el.className = "status show " + (type === "success" ? "success-msg" : type === "error" ? "error-msg" : "info-msg");
            clearTimeout(statusTimer);
            statusTimer = setTimeout(() => el.classList.remove("show"), 8000);
        }

        function closeModal(id) { $(id).classList.remove("show"); }

        function escapeHtml(value) {
            return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                .replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function showJsonPreview() {
            $("jsonPreview").textContent = JSON.stringify(records, null, 2);
            $("previewModal").classList.add("show");
        }

        async function copyJson() {
            try {
                await navigator.clipboard.writeText(JSON.stringify(records, null, 2));
                showStatus("JSON copied to clipboard.", "success");
            } catch {
                showStatus("Could not copy JSON. Select the preview text manually.", "error");
            }
        }

        $("sourceSelect").addEventListener("change", async event => {
            if (hasUnsavedChanges && !confirm("You have unsaved changes. Switching source will discard them. Continue?")) {
                event.target.value = currentSource; return;
            }
            currentSource = event.target.value;
            $("searchInput").value = "";
            await loadSource();
        });
        $("saveBtn").addEventListener("click", saveJsonFile);
        $("addBtn").addEventListener("click", () => { $("newUrl").value = ""; $("addModal").classList.add("show"); $("newUrl").focus(); });
        $("bulkBtn").addEventListener("click", () => { $("bulkUrls").value = ""; $("bulkModal").classList.add("show"); });
        $("previewBtn").addEventListener("click", showJsonPreview);
        $("reloadBtn").addEventListener("click", async () => {
            if (hasUnsavedChanges && !confirm("Reloading will discard unsaved changes. Continue?")) return;
            await loadSource();
        });
        $("confirmAddBtn").addEventListener("click", addArticle);
        $("confirmChangeBtn").addEventListener("click", changeArticleUrl);
        $("confirmBulkBtn").addEventListener("click", addBulkArticles);
        $("copyBtn").addEventListener("click", copyJson);
        $("searchInput").addEventListener("input", render);

        $("recordsBody").addEventListener("click", event => {
            const button = event.target.closest("button[data-action]");
            if (!button) return;
            const id = Number(button.dataset.id);
            switch (button.dataset.action) {
                case "flag": toggleUpdate(id); break;
                case "change": openChangeModal(id); break;
                case "undo": undoChange(id); break;
                case "delete": toggleDelete(id); break;
            }
        });

        document.querySelectorAll(".jm [data-close]").forEach(button =>
            button.addEventListener("click", () => closeModal(button.dataset.close)));
        document.querySelectorAll(".jm .modal").forEach(modal => modal.addEventListener("click", event => {
            if (event.target === modal) closeModal(modal.id);
        }));
        document.addEventListener("keydown", event => {
            if (event.key === "Escape") document.querySelectorAll(".jm .modal.show").forEach(m => closeModal(m.id));
            if (event.ctrlKey && event.key.toLowerCase() === "s") { event.preventDefault(); saveJsonFile(); }
        });
        window.addEventListener("beforeunload", event => {
            if (hasUnsavedChanges) { event.preventDefault(); event.returnValue = ""; }
        });

        loadSource();
    })();
</script>